# Local development only. Store deployed values with Sites-managed secrets.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
ALLOW_DEV_AUTH=false
# Optional hosting-owner-approved OpenAI subject -> provider user ID links.
# Leave empty unless both exact identities have been verified and linking authorised.
# Store private IDs only in hosting secrets; never match identities by email.
OPENAI_SIGNIN_LINKS=
MAX_ATTACHMENT_BYTES=10485760
MAX_TOTAL_ATTACHMENT_BYTES=20971520
BLOCKED_ATTACHMENT_EXTENSIONS=.exe,.com,.bat,.cmd,.ps1,.vbs,.js,.jar,.scr,.msi
BLOCKED_ATTACHMENT_MIME_TYPES=application/x-msdownload,application/x-dosexec
OPENAI_APPS_CHALLENGE=
# Optional marketplace-review login. Store deployed values as Sites secrets.
REVIEW_ACCESS_USERNAME=
REVIEW_ACCESS_PASSWORD_HASH=
REVIEW_ACCESS_USER_ID=
REVIEW_ACCESS_EMAIL=

# Optional social platform. Leave sends and scheduling off until verified.
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TIER=development
SOCIAL_PUBLIC_ORIGIN=https://senderdeck.devectus.com.au
SOCIAL_SEND_ENABLED=false
# Optional operator-only WhatsApp test scope JSON, at most two hours. Empty disables it.
# Exact appId, brandId, accountId, phoneNumberId, messagingAccountId, recipient,
# startsAt and expiresAt (epoch milliseconds). No wildcards. See docs/WHATSAPP-BUSINESS.md.
WHATSAPP_TEST_SEND_SCOPE=
SOCIAL_SCHEDULER_ENABLED=false
SOCIAL_MAINTENANCE_TOKEN=
# Hosting-controlled platform operator IDs, comma-separated. Empty denies all.
# Workspace ownership does not grant platform administration. Never set from a tenant request.
SOCIAL_OPERATOR_USER_IDS=
# LinkedIn remains gated pending Community Management and data-use approval.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# WhatsApp Business OAuth configuration for existing Cloud API numbers.
# Must grant whatsapp_business_management and whatsapp_business_messaging.
# Register /oauth/social/whatsapp/callback on the same platform Meta app.
WHATSAPP_LOGIN_CONFIG_ID=

# Separate Meta Embedded Signup v4 configuration for Business app Coexistence.
# Requires Meta Tech Provider eligibility, SDK login, allowed JavaScript domains,
# and all five Coexistence webhook fields. Existing Cloud API config stays separate.
WHATSAPP_COEXISTENCE_CONFIG_ID=
