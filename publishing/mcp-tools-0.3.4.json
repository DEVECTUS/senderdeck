    {
      "name": "draft_update",
      "description": "Edit an existing draft in place; never sends or creates another draft. Inspect first and pass expectedRevision. Optional from selects a current authorised Gmail identity; omission preserves saved From and empty from is invalid. Other omitted fields are preserved; empty strings/arrays clear requested values. attachments replaces ALL files, including inline images. Outlook has one body: use bodyHtml for HTML drafts, or bodyHtml: empty string plus bodyText to explicitly switch to text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "description": "One bare sender email. For Google, choose a current senderIdentities email from account_list under this accountId; only Gmail primary/accepted aliases are allowed. Omission uses the connected primary on create/reply and preserves saved From on update. Microsoft permits only its connected primary. Changing From invalidates all prior send approval."
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cc": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bcc": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subject": {
            "type": "string"
          },
          "bodyText": {
            "type": "string",
            "description": "Selective plain-text update. Gmail preserves omitted HTML. Outlook HTML drafts require bodyHtml edits, or bodyHtml: empty string plus bodyText to explicitly switch to text."
          },
          "bodyHtml": {
            "type": "string",
            "description": "Selective HTML update including signature. Empty string clears HTML content; omission preserves it. Outlook stores only one body format."
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string"
                },
                "contentType": {
                  "type": "string"
                },
                "contentBase64": {
                  "type": "string",
                  "description": "Base64 bytes; passed directly to the provider."
                },
                "contentId": {
                  "type": "string",
                  "description": "For inline images: unique bare content ID, e.g. logo@signature, referenced as src=\"cid:logo@signature\" in bodyHtml. Omit for regular attachments."
                }
              },
              "required": [
                "filename",
                "contentType",
                "contentBase64"
              ],
              "additionalProperties": false
            },
            "description": "Replaces ALL saved attachments, including inline images. Omit to preserve them; [] removes all."
          },
          "draftId": {
            "type": "string"
          },
          "expectedRevision": {
            "type": "string",
            "description": "Revision returned by draft_inspect; stale updates fail."
          }
        },
        "required": [
          "accountId",
          "draftId",
          "expectedRevision"
        ],
        "additionalProperties": false
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "senderdeck"
          ]
        }
      ],
      "annotations": {
        "title": "Update an email draft",
        "readOnlyHint": false,
        "openWorldHint": true,
        "destructiveHint": true
      }
    },
    {
      "name": "draft_inspect",
      "description": "Re-read saved body, formatting, thread metadata, exact effective sender address, Gmail fromHeader, recipients, subject, attachments and revision. sender may be a Gmail alias under accountId. Inspect immediately before requesting fresh send confirmation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "draftId": {
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "draftId"
        ],
        "additionalProperties": false
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "senderdeck"
          ]
        }
      ],
      "annotations": {
        "title": "Inspect an email draft",
        "readOnlyHint": true,
        "openWorldHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "email_send",
      "description": "Send one existing draft only after a separate explicit confirmation of its exact sender, recipients, subject, attachments and inspected revision. Revalidates Gmail From against current authorised sendAs identities and rechecks the revision; revoked aliases or changed drafts fail. Never bulk or automatic send.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "draftId": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean",
            "const": true
          },
          "confirmation": {
            "type": "object",
            "properties": {
              "revision": {
                "type": "string",
                "description": "Copy revision from the immediately preceding draft_inspect. Any edit invalidates earlier approval."
              },
              "sender": {
                "type": "string"
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cc": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "bcc": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subject": {
                "type": "string"
              },
              "attachments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "filename": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "filename",
                    "size"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "revision",
              "sender",
              "to",
              "cc",
              "bcc",
              "subject",
              "attachments"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "accountId",
          "draftId",
          "confirmed",
          "confirmation"
        ],
        "additionalProperties": false
      },
      "securitySchemes": [
        {
          "type": "oauth2",
          "scopes": [
            "senderdeck"
          ]
        }
      ],
      "annotations": {
        "title": "Send a confirmed email",
        "readOnlyHint": false,
        "openWorldHint": true,
        "destructiveHint": true
      }
    },
